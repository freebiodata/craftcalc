---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Changelog: What Changed and When | CraftCalc';
const description = 'Real, dated updates to CraftCalc tools and game mechanics. No cosmetic date bumps: every entry lists what actually changed.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Changelog' },
];

const entries = [
  {
    date: '2026-10-08',
    title: 'Initial release',
    items: [
      'Launched 3 tools: circle & oval generator, Nether portal calculator, beacon range calculator.',
      'Circle generator includes outline, filled and ring styles with copyable build plans.',
      'All maths client-side; no accounts, no uploads.',
    ],
  },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/changelog/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Changelog</h1>
    <p class="lead">
      What actually changed, when, and why. We only touch dates when there is a real update behind them.
    </p>

    {entries.map((e) => (
      <section class="section">
        <h2 id={e.date} style="margin-top:0">{e.date}: {e.title}</h2>
        <ul>
          {e.items.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    ))}

    <section class="section">
      <h2 id="planned">Planned</h2>
      <ul>
        <li>Sphere generator as a dedicated tool with dome mode.</li>
        <li>Enchanting calculator with per-enchantment availability.</li>
        <li>XP calculator with mob and activity tables.</li>
      </ul>
      <p class="small muted">Plans are not promises; entries move to a dated release when they ship.</p>
    </section>
  </div>
</Base>
