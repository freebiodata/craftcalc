---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import TrustBlock from '../../components/TrustBlock.astro';
import { site } from '../../data/site';

const title = 'Minecraft Beacon Calculator: Range & Materials';
const description =
  'Plan your beacon: effect radius and exact pyramid materials for levels 1-4. See block and ingot counts at a glance. Free, in-browser Minecraft tool.';

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${site.url}/beacon-calculator/#app`,
    name: 'Minecraft Beacon Calculator',
    url: `${site.url}/beacon-calculator/`,
    description:
      'Compute beacon effect range and pyramid material costs for levels 1 to 4, with ingot equivalents.',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All tools', href: '/tools/' },
  { name: 'Beacon calculator' },
];

const faq = [
  {
    q: 'How far does a beacon reach at each level?',
    a: 'The effect radius grows with pyramid level: 20 blocks at level 1, 30 at level 2, 40 at level 3 and 50 at level 4. The radius applies horizontally and vertically from the beacon.',
  },
  {
    q: 'How many blocks does each beacon level need?',
    a: 'Level 1: 9 blocks. Level 2: 34. Level 3: 83. Level 4: 164. Each block of iron, gold, diamond, netherite or emerald costs 9 ingots (netherite: 9 ingots of netherite scrap-equivalent materials), so multiply by 9 for the ingot count.',
  },
  {
    q: 'Do all pyramid layers need the same material?',
    a: 'No: any mix of the four mineral block types works, so you can build the big lower layers from cheap iron and the top from emerald or diamond. The game only checks that the layers are complete mineral blocks.',
  },
  {
    q: 'How many beacons can one pyramid power?',
    a: 'Exactly one beacon sits on top of a pyramid. If you want multiple beacons, each needs its own pyramid (pyramids cannot be shared in vanilla).',
  },
  {
    q: 'What is the minimum for a working beacon?',
    a: 'Level 1 (9 blocks: a 3×3 base) plus a beacon block on top and a clear line of sight to the sky. You need to defeat the Wither to craft the beacon itself; the pyramid is the easy part.',
  },
];
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  canonical="/beacon-calculator/"
>
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>Beacon Calculator</h1>
      <p class="value-line">
        Plan your beacon pyramid: pick a level and see the exact effect radius, block count and ingot
        cost before you start grinding.
      </p>
      <ul class="trust-microline">
        <li class="badge badge-green">Runs in your browser</li>
        <li class="badge">Free · No sign-up</li>
        <li class="badge">Levels 1–4</li>
      </ul>
    </div>

    <section class="tool" aria-labelledby="tool-heading">
      <h2 id="tool-heading" class="visually-hidden">Beacon calculator tool</h2>

      <div class="chips" aria-label="Beacon level presets">
        <button class="chip" type="button" data-level="1">Level 1 (9 blocks)</button>
        <button class="chip" type="button" data-level="2">Level 2 (34)</button>
        <button class="chip" type="button" data-level="3">Level 3 (83)</button>
        <button class="chip" type="button" data-level="4">Level 4 (164)</button>
      </div>

      <div class="tool-grid cols-2" style="margin-top:14px">
        <div class="field">
          <label for="level">Pyramid level</label>
          <select id="level">
            <option value="1" selected>Level 1 (3×3 base)</option>
            <option value="2">Level 2 (5×5 base)</option>
            <option value="3">Level 3 (7×7 base)</option>
            <option value="4">Level 4 (9×9 base)</option>
          </select>
        </div>
        <div class="field">
          <label for="mat">Preferred material</label>
          <select id="mat">
            <option value="iron" selected>Iron</option>
            <option value="gold">Gold</option>
            <option value="diamond">Diamond</option>
            <option value="emerald">Emerald</option>
            <option value="netherite">Netherite</option>
          </select>
        </div>
      </div>

      <div class="result-panel" aria-live="polite">
        <div class="small muted" id="result-caption">Your beacon plan</div>
        <div class="result-value" id="result-value">-</div>
        <div class="result-meta">
          <div class="kv"><div class="k">Effect radius</div><div class="v" id="out-radius">-</div></div>
          <div class="kv"><div class="k">Mineral blocks</div><div class="v" id="out-blocks">-</div></div>
          <div class="kv"><div class="k">Ingots needed</div><div class="v" id="out-ingots">-</div></div>
          <div class="kv"><div class="k">Covered area</div><div class="v" id="out-area">-</div></div>
        </div>
      </div>

      <p class="small muted" style="margin-top:12px">
        All maths runs locally in your browser. Nothing you enter is uploaded.
      </p>
    </section>

    <section class="section" aria-labelledby="table">
      <h2 id="table">Beacon levels at a glance</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Level</th>
              <th>Base size</th>
              <th class="num">Blocks</th>
              <th class="num">Ingots</th>
              <th class="num">Effect radius</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>1</td><td>3×3</td><td class="num">9</td><td class="num">81</td><td class="num">20 blocks</td></tr>
            <tr><td>2</td><td>5×5</td><td class="num">34</td><td class="num">306</td><td class="num">30 blocks</td></tr>
            <tr><td>3</td><td>7×7</td><td class="num">83</td><td class="num">747</td><td class="num">40 blocks</td></tr>
            <tr><td>4</td><td>9×9</td><td class="num">164</td><td class="num">1,476</td><td class="num">50 blocks</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">
        Blocks count all four pyramid tiers combined; ingots assume 9 ingots per block. Radius applies in every direction from the beacon.
      </p>
    </section>

    <Faq items={faq} />

    <TrustBlock>
      <p class="mb-0">
        <strong>Mechanics source:</strong> Minecraft Wiki documented values, re-checked 08 Oct 2026;
        see the <a href="/methodology/">methodology page</a>. Building tip: use the cheapest material
        for the big layers and your preferred block for the top tiers visible from above.
      </p>
    </TrustBlock>

    <section class="section" aria-labelledby="related">
      <h2 id="related">Related tools</h2>
      <ul class="related-grid" style="list-style:none;padding:0">
        <li><a class="tool-card" href="/circle-generator/"><span class="tc-title">Circle Generator</span><p class="tc-desc">Perfect circles and ovals on the block grid.</p></a></li>
        <li><a class="tool-card" href="/nether-portal-calculator/"><span class="tc-title">Nether Portal Calculator</span><p class="tc-desc">Coordinate conversion at the 8:1 ratio.</p></a></li>
        <li><a class="tool-card" href="/tools/"><span class="tc-title">All tools →</span><p class="tc-desc">Everything CraftCalc can do.</p></a></li>
      </ul>
    </section>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id)!;

    const LEVELS: Record<number, { blocks: number; radius: number; base: number }> = {
      1: { blocks: 9, radius: 20, base: 3 },
      2: { blocks: 34, radius: 30, base: 5 },
      3: { blocks: 83, radius: 40, base: 7 },
      4: { blocks: 164, radius: 50, base: 9 },
    };

    function compute() {
      const level = parseInt(($('level') as HTMLSelectElement).value);
      const mat = ($('mat') as HTMLSelectElement).value;
      const info = LEVELS[level];
      if (!info) return;

      const ingots = info.blocks * 9;
      const area = Math.PI * info.radius * info.radius;

      $('result-caption').textContent = `Level ${level} beacon in ${mat.charAt(0).toUpperCase() + mat.slice(1)}`;
      $('result-value').textContent = `${info.blocks} blocks needed`;
      $('out-radius').textContent = `${info.radius} blocks`;
      $('out-blocks').textContent = `${info.blocks} blocks = ${ingots.toLocaleString()} ingots`;
      $('out-ingots').textContent = `${ingots.toLocaleString()} ${mat}`;
      $('out-area').textContent = `≈ ${Math.round(area).toLocaleString()} m² (circle)`;
      (window as any).__beacon = `Level ${level}: ${info.blocks} blocks (${ingots.toLocaleString()} ingots), radius ${info.radius}`;
    }

    document.querySelectorAll('[data-level]').forEach((chip) => {
      chip.addEventListener('click', () => {
        ($('level') as HTMLSelectElement).value = (chip as HTMLElement).dataset.level!;
        compute();
      });
    });

    ['level', 'mat'].forEach((id) => $(id).addEventListener('input', compute));
    compute();
  </script>
</Base>
