---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import TrustBlock from '../../components/TrustBlock.astro';
import { site } from '../../data/site';

const title = 'Minecraft Circle Generator: 2D & 3D Block Plan | CraftCalc';
const description =
  'Generate pixel-perfect Minecraft circles, ovals and spheres. See the exact block grid, switch to 3D sphere layers, and copy build plans. Free, no sign-up.';

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${site.url}/circle-generator/#app`,
    name: 'Minecraft Circle Generator',
    url: `${site.url}/circle-generator/`,
    description:
      'Rasterize pixel-perfect Minecraft circles, ovals and spheres into block grids with layer-by-layer build views.',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All tools', href: '/tools/' },
  { name: 'Circle generator' },
];

const faq = [
  {
    q: 'How does the Minecraft circle generator work?',
    a: 'It plots a mathematical circle on the block grid so the outline looks as round as possible in blocky terrain, then shows you the exact cells to place. You build the marked cells from the preview; the pattern scales to any radius.',
  },
  {
    q: 'What is the best way to build a big circle in Minecraft?',
    a: 'Use the outline as a guide: mark the centre block, build one quarter from the preview, then mirror it to the other three quadrants. For tall builds (towers, domes), switch to the sphere mode and build layer by layer using the layer numbers.',
  },
  {
    q: 'Why do some circle generators look different from others?',
    a: 'Different rasterization rules (which cells get filled when the true circle passes between blocks) produce slightly different outlines at the same radius. We use the standard midpoint circle algorithm, which keeps the symmetry exact on all four quadrants, the property you want for build quality.',
  },
  {
    q: 'What radius should I choose?',
    a: 'Radius = distance in blocks from the centre to the edge. For beacons (radius 20–50 blocks coverage) or crop farms, match the radius to the purpose; for decoration, odd radii (5, 7, 9) often look cleaner at small sizes.',
  },
  {
    q: 'Can I build a sphere in Minecraft with this?',
    a: 'Yes: switch to Sphere mode and you get a layer-by-layer plan. Each layer is a circle of decreasing radius; we list which layers contain which ring so you can build from the equator upward and downward, or top-down for domes.',
  },
  {
    q: 'Is the tool free?',
    a: 'Yes, completely. No sign-up, no watermark, nothing uploaded. It runs entirely in your browser, so it works offline once loaded.',
  },
];
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  canonical="/circle-generator/"
>
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>Minecraft Circle Generator</h1>
      <p class="value-line">
        Pixel-perfect circles and ovals on the block grid, plus full sphere layer plans for domes and
        towers. Pick a size, set the mode, and build from the exact pattern.
      </p>
      <ul class="trust-microline">
        <li class="badge badge-green">Runs in your browser</li>
        <li class="badge">Free · No sign-up</li>
        <li class="badge">2D grid + 3D sphere layers</li>
      </ul>
    </div>

    <section class="tool" aria-labelledby="tool-heading">
      <h2 id="tool-heading" class="visually-hidden">Circle generator tool</h2>

      <div class="tool-grid cols-2">
        <div>
          <div class="field">
            <label for="mode">Shape</label>
            <select id="mode">
              <option value="circle" selected>Circle</option>
              <option value="oval">Oval / ellipse</option>
              <option value="sphere">Sphere (3D layers)</option>
            </select>
          </div>

          <div class="field">
            <label for="radius">Radius (blocks)</label>
            <input type="number" id="radius" inputmode="numeric" min="1" max="64" step="1" value="10" />
            <span class="helper">Distance from centre to edge, 1 to 64.</span>
            <span class="error" role="alert">Enter a radius between 1 and 64.</span>
          </div>

          <div class="field" id="radius2-field" hidden>
            <label for="radius2">Second radius (for ovals)</label>
            <input type="number" id="radius2" inputmode="numeric" min="1" max="64" step="1" value="16" />
          </div>

          <div class="field">
            <label for="style">Style</label>
            <select id="style">
              <option value="outline" selected>Outline only</option>
              <option value="filled">Filled</option>
              <option value="ring">Ring (thickness 2)</option>
            </select>
          </div>

          <div class="field">
            <label style="display:flex;justify-content:space-between">
              <span>Preview grid</span>
              <span class="small muted" id="dims">-</span>
            </label>
            <div class="mt-0" style="border:1px solid var(--border-strong);border-radius:var(--radius);padding:8px;background:var(--bg-inset);overflow:auto;max-height:480px">
              <pre id="preview" style="margin:0;font-size:11px;line-height:1.05;font-family:var(--font-mono);color:var(--accent-strong)">-</pre>
            </div>
          </div>
        </div>

        <div>
          <div class="result-panel" id="result-panel" style="margin-top:0">
            <div class="small muted" id="result-caption">Build summary</div>
            <div class="result-value" id="block-count">-</div>
            <div class="result-meta">
              <div class="kv"><div class="k">Blocks in pattern</div><div class="v" id="out-blocks">-</div></div>
              <div class="kv"><div class="k">Span</div><div class="v" id="out-span">-</div></div>
              <div class="kv"><div class="k">Layer count</div><div class="v" id="out-layers">-</div></div>
            </div>
            <div class="result-actions">
              <button class="btn btn-primary" type="button" id="copy-plan"><span class="normal-label">Copy build plan</span><span class="copied-label">✓ Copied</span></button>
              <button class="btn btn-secondary" type="button" id="copy-grid"><span class="normal-label">Copy grid text</span><span class="copied-label">✓ Copied</span></button>
            </div>
          </div>

          <div class="callout">
            <div class="callout-title">How to build it</div>
            <p class="mb-0" id="build-hint">Mark the centre block first, then mirror one quadrant to the other three. Odd/even sizes: radius r gives a grid of 2r+1 cells.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="how">
      <h2 id="how">How Minecraft circles are calculated</h2>
      <p>
        The outline uses the <strong>midpoint circle algorithm</strong> (Bresenham, 1965), the standard
        method for rasterizing a circle on a grid: it starts at the top of the circle and steps through
        the first octant, plotting symmetric copies into the other seven. This guarantees the
        four-fold symmetry that makes builds look clean. Ovals sample the parametric ellipse;
        spheres stack decreasing circles layer by layer.
      </p>
      <p class="small muted">
        The maths is printed in full on the <a href="/methodology/">methodology page</a>. The tool runs
        entirely in your browser with no uploads.
      </p>
    </section>

    <Faq items={faq} />

    <TrustBlock>
      <p class="mb-0">
        <strong>Build quality notes:</strong> at radius 1–3 no pattern can look perfectly round in
        blocks; we show the closest grid form. For beacons and farms, match the radius to the
        coverage you need (beacon calculator linked below).
      </p>
    </TrustBlock>

    <section class="section" aria-labelledby="related">
      <h2 id="related">Related tools</h2>
      <ul class="related-grid" style="list-style:none;padding:0">
        <li><a class="tool-card" href="/sphere-generator/"><span class="tc-title">Sphere Generator</span><p class="tc-desc">Dedicated dome and ball plans, layer by layer.</p></a></li>
        <li><a class="tool-card" href="/beacon-calculator/"><span class="tc-title">Beacon Calculator</span><p class="tc-desc">Pyramid materials and effect range for any level.</p></a></li>
        <li><a class="tool-card" href="/nether-portal-calculator/"><span class="tc-title">Nether Portal Calculator</span><p class="tc-desc">Overworld and Nether coordinate matching.</p></a></li>
      </ul>
    </section>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id)!;

    function circleOutline(r: number): Array<[number, number]> {
      const cells: Array<[number, number]> = [];
      let x = r, z = 0, err = 1 - r;
      const add = (a: number, b: number) => cells.push([a, b]);
      while (x >= z) {
        add(x, z); add(z, x); add(-z, x); add(-x, z);
        add(-x, -z); add(-z, -x); add(z, -x); add(x, -z);
        z += 1;
        if (err < 0) err += 2 * z + 1;
        else { x -= 1; err += 2 * (z - x) + 1; }
      }
      return cells;
    }
    function circleFill(r: number): Array<[number, number]> {
      const cells: Array<[number, number]> = [];
      for (let x = -r; x <= r; x++) for (let z = -r; z <= r; z++) if (x * x + z * z <= r * r) cells.push([x, z]);
      return cells;
    }
    function circleRing(r: number, t: number): Array<[number, number]> {
      const cells: Array<[number, number]> = [];
      const inner = Math.max(0, r - t) ** 2;
      for (let x = -r; x <= r; x++) for (let z = -r; z <= r; z++) {
        const d = x * x + z * z;
        if (d <= r * r && d >= inner) cells.push([x, z]);
      }
      return cells;
    }
    function ellipseOutline(rx: number, rz: number): Array<[number, number]> {
      const cells: Array<[number, number]> = [];
      const steps = Math.ceil(2 * Math.PI * Math.max(rx, rz) * 2);
      for (let i = 0; i < steps; i++) {
        const t = (i / steps) * 2 * Math.PI;
        cells.push([Math.round(rx * Math.cos(t)), Math.round(rz * Math.sin(t))]);
      }
      return cells;
    }
    function dedupe(cells: Array<[number, number]>): Array<[number, number]> {
      const seen = new Set<string>(); const out: Array<[number, number]> = [];
      for (const [x, z] of cells) { const k = x + ',' + z; if (!seen.has(k)) { seen.add(k); out.push([x, z]); } }
      out.sort((a, b) => a[1] - b[1] || a[0] - b[0]);
      return out;
    }

    let lastGridText = '';
    let lastPlanText = '';

    function compute() {
      const mode = ($('mode') as HTMLSelectElement).value;
      const r = parseInt(($('radius') as HTMLInputElement).value);
      const r2 = parseInt(($('radius2') as HTMLInputElement).value);
      const style = ($('style') as HTMLSelectElement).value;
      const valid = Number.isFinite(r) && r >= 1 && r <= 64;
      ($('radius') as HTMLInputElement).closest('.field')!.classList.toggle('invalid', !valid);
      ($('radius2-field') as HTMLElement).hidden = mode !== 'oval';
      if (!valid) return;

      let cells: Array<[number, number]>;
      let span: number;
      let layers: number;
      if (mode === 'oval') {
        cells = dedupe(ellipseOutline(r, Number.isFinite(r2) && r2 > 0 ? r2 : r * 2));
        span = 2 * Math.max(r, r2) + 1;
        layers = 1;
      } else if (mode === 'sphere') {
        // sphere: list layer rings for each y from -r..r
        layers = 2 * r + 1;
        const layerLines: string[] = [];
        let total = 0;
        for (let y = -r; y <= r; y++) {
          const rr = Math.floor(Math.sqrt(Math.max(0, r * r - y * y)));
          const ring = circleOutline(rr);
          total += ring.length;
          layerLines.push(`Layer ${y + r + 1} (radius ${rr})`);
        }
        // preview shows middle layer outline
        cells = circleOutline(r);
        span = 2 * r + 1;
        lastPlanText = `Sphere r=${r}: ${layers} layers\n` + layerLines.join('\n');
        ($('result-caption') as HTMLElement).textContent = `Sphere: ${layers} layers`;
        ($('out-layers') as HTMLElement).textContent = `${layers}`;
        ($('out-blocks') as HTMLElement).textContent = `≈ ${total}`;
        ($('out-span') as HTMLElement).textContent = `${span} × ${span} × ${span}`;
        ($('block-count') as HTMLElement).textContent = `${layers} layers`;
        render(cells, r, r);
        return;
      } else {
        cells = style === 'filled' ? circleFill(r) : style === 'ring' ? circleRing(r, 2) : circleOutline(r);
        span = 2 * r + 1;
        layers = 1;
      }

      const uniq = dedupe(cells);
      ($('result-caption') as HTMLElement).textContent = `${mode === 'oval' ? 'Oval' : 'Circle'} r=${r}${mode === 'oval' ? '/' + r2 : ''}`;
      ($('block-count') as HTMLElement).textContent = `${uniq.length} blocks`;
      ($('out-blocks') as HTMLElement).textContent = `${uniq.length}`;
      ($('out-span') as HTMLElement).textContent = `${span} × ${span}`;
      ($('out-layers') as HTMLElement).textContent = `${layers}`;
      lastPlanText = `${mode === 'oval' ? 'Oval' : 'Circle'} radius ${r}${mode === 'oval' ? ' x ' + r2 : ''}, ${style}, ${uniq.length} blocks, span ${span}\n`;
      render(uniq, r, mode === 'oval' ? r2 : r);
    }

    function render(cells: Array<[number, number]>, rx: number, rz: number) {
      const minX = Math.min(...cells.map(c => c[0])) - 1;
      const maxX = Math.max(...cells.map(c => c[0])) + 1;
      const minZ = Math.min(...cells.map(c => c[1])) - 1;
      const maxZ = Math.max(...cells.map(c => c[1])) + 1;
      const w = maxX - minX + 1, h = maxZ - minZ + 1;
      const grid: string[][] = Array.from({ length: h }, () => Array(w).fill('·'));
      for (const [x, z] of cells) grid[z - minZ][x - minX] = '#';
      // mark centre
      if (grid[-minZ] && grid[-minZ][-minX] === '·') grid[-minZ][-minX] = '+';
      const text = grid.map(row => row.join('')).join('\n');
      ($('preview') as HTMLElement).textContent = text;
      lastGridText = text;
      ($('dims') as HTMLElement).textContent = `${w} × ${h} blocks`;
      ($('build-hint') as HTMLElement).textContent = `Grid shown: ${w} by ${h} blocks (each character is one block). Mark the centre (+) first, then build outward using the # pattern.`;
    }

    ['mode', 'radius', 'radius2', 'style'].forEach(id => $(id).addEventListener('input', compute));

    ($('copy-plan') as HTMLButtonElement).addEventListener('click', async () => {
      await copyText(lastPlanText + '\n' + lastGridText);
      flash('copy-plan');
    });
    ($('copy-grid') as HTMLButtonElement).addEventListener('click', async () => {
      await copyText(lastGridText);
      flash('copy-grid');
    });

    async function copyText(t: string) {
      try { await navigator.clipboard.writeText(t); } catch {
        const ta = document.createElement('textarea'); ta.value = t;
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
      }
    }
    function flash(id: string) {
      const btn = $(id); btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1800);
    }

    compute();
  </script>
</Base>
